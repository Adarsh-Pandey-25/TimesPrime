# Committed on purpose: the environment for `npm test` and CI.
#
# In the test environment Next loads .env.test before .env and keeps the first
# value it finds for a key, an empty one included (@next/env processEnv). Every
# key below is empty, so a test never receives the owner's real credentials from
# the root .env. Keep it in step with .env.example: envExample.test.ts fails if a
# key is missing here, or holds a value.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEWSDATA_API_KEY=
ANTHROPIC_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_LEGACY_LOGIN=
NEXT_PUBLIC_APP_URL=

# Copy this file to .env (at the repository root, where every app reads it) and fill in real values.
# .env is gitignored: never commit it.
# Every variable the code reads is listed here, one line each (F-009). Unset optional ones degrade
# as described; nothing else is read.

# --- Supabase (Dashboard -> Settings -> API) ---
# Project URL. Required for the stored feed, admin and audit log; without it the app runs on NewsData.io and mock articles.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key. Used only when the service-role key is unset, and then RLS refuses every write (docs/OPERATIONS.md, Runbooks).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only service-role key; bypasses RLS. Required for ingest, purge, admin writes and the audit log. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- News source ---
# NewsData.io API key (https://newsdata.io). Required: /api/health reports degraded without it.
NEWSDATA_API_KEY=your-newsdata-api-key

# --- AI ---
# Anthropic API key (https://console.anthropic.com) for /api/chat and category classification; without it chat says "unavailable" and classification is skipped.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Upstash Redis (https://upstash.com) ---
# Shared cache and the login/scrape rate limits across instances; without both, each instance uses its own memory.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Sentry (https://sentry.io) ---
# DSN for error reports from browser, server and edge; not a secret. Without it nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
# Build-time only, for source-map upload; safe to leave unset locally.
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug

# --- URLs ---
# The site's public origin: canonical links, the sitemap, robots.txt and og:url (R1-09). Read at build time.
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
# "1" for a build that must not be indexed (staging): robots.txt disallows all, every response says noindex.
# Read at build time. Leave it unset for the public site.
NEXT_PUBLIC_SITE_NOINDEX=

# --- The Desk's media library (Panel 2, M4) ---
# The S3 bucket the images are kept in (the server: the bucket in Mumbai, read and written with the
# server's role). Unset, they are kept in a local folder, MEDIA_LOCAL_DIR or .media at the root.
MEDIA_BUCKET=
# The bucket's region: ap-south-1 (Mumbai) when unset.
MEDIA_REGION=
# Where pages show the images: https://<site>/media on the server (CloudFront serves the bucket there);
# unset, /media, which each app serves from the local folder.
MEDIA_PUBLIC_BASE=
MEDIA_LOCAL_DIR=

# The AI chat for readers (B-06): "1" turns it on. Unset, it is off: no chat button, no ask-the-article
# panel, and /api/chat answers 404. Read at build time.
NEXT_PUBLIC_AI_CHAT_ENABLED=

# --- Hosting ---
# Proxies in front of the app that append to X-Forwarded-For: 2 for the reader site (CloudFront, then Nginx),
# 1 for the back office (Nginx only), 0 locally.
# The client IP for rate limits and the audit log is the entry this many from the right (R1-05).
TRUSTED_PROXY_HOPS=0

# The worker's state folder: when the news refresh last started, so a timer tick before the interval
# has passed can skip (R12-04). On the server a Docker volume; unset, /var/lib/timesprime.
WORKER_STATE_DIR=

# "1" makes the news refresh batched (R12-05): several categories per NewsData call, 4 calls a run
# instead of 14. Off until the NewsData Basic plan is bought and the dry run (refresh-news-dry-run) passes.
NEWS_REFRESH_BATCHED=

# --- Set by the platform; do not set them here ---
# NODE_ENV (Next.js), NEXT_RUNTIME (Next.js, nodejs or edge), CI (CI providers; makes the Sentry build plugin verbose).

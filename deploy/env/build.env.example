# Laptop only: deploy/env/.env.build (git-ignored). Read by build-and-push.sh and run-local.sh.
# Public values, inlined into the images at build time; still kept out of the repository.
# The ECR registry, e.g. <account-id>.dkr.ecr.ap-south-1.amazonaws.com
ECR_REGISTRY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://timesprime247.com
# Sentry's browser DSN (EU region). Public by design.
NEXT_PUBLIC_SENTRY_DSN=
# "1" turns the AI chat on (B-06). Leave empty: it stays off.
NEXT_PUBLIC_AI_CHAT_ENABLED=

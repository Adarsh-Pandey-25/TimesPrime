# Server: /opt/timesprime/env/.env.edge (mode 600). Nginx.
READER_ORIGIN_HOST=origin.timesprime247.com
ADMIN_HOST=admin.timesprime247.com
# A long random value (openssl rand -hex 32), also set as the X-Origin-Verify custom header on
# the CloudFront origin. Requests to the reader origin without it are refused.
ORIGIN_SECRET=

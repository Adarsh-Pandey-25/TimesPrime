# Server: /opt/timesprime/env/.env.shared (mode 600). Loaded by web, admin and worker.
# The worker is not a Next.js build, so it reads these at run time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The same value as SRH_TOKEN in .env.redis: the apps' token for the local Redis REST proxy.
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
# The Desk's media library (Panel 2, M4), both set together once the manager's media steps are done
# (docs/OPERATIONS.md, "The Desk's images"): the S3 bucket in Mumbai the images are kept in, and the
# address pages show them at, https://timesprime247.com/media (CloudFront's /media/* behaviour).
MEDIA_BUCKET=
MEDIA_PUBLIC_BASE=

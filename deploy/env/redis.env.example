# Server: /opt/timesprime/env/.env.redis (mode 600). Redis and its REST proxy.
# A long random value: openssl rand -hex 32
REDIS_PASSWORD=
# Another long random value; the same as UPSTASH_REDIS_REST_TOKEN in .env.shared.
SRH_TOKEN=
# redis://:<REDIS_PASSWORD>@redis:6379 with the password above.
SRH_CONNECTION_STRING=

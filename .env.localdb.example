# The local database's environment: copy to .env.localdb with `node scripts/local-db.mjs env`, which
# fills in the four Supabase values from the running local stack. Used only through
# scripts/localdb/run.mjs (npm run dev:local, start:local, test:db, test:e2e), which refuses to start
# unless every variable .env.local.example sets is set here too, and unless the database is local.
# .env.localdb is gitignored. Its Supabase keys are the local stack's well-known development keys.

# --- Supabase: the local stack (supabase/config.toml) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=filled-in-by-local-db-env
SUPABASE_SERVICE_ROLE_KEY=filled-in-by-local-db-env
# Direct Postgres, for the database tests (npm run test:db).
LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- External services: off locally ---
NEWSDATA_API_KEY=
ANTHROPIC_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Secrets the app checks: local-only values ---
CRON_SECRET=local-cron-secret
ADMIN_PASSWORD=local-shared-password
ADMIN_SESSION_SECRET=local-session-secret-not-for-production
ADMIN_LEGACY_LOGIN=on

# --- URLs: the local app runs on port 3100, clear of the developer's own `npm run dev` on 3000 ---
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_BASE_URL=http://localhost:3100

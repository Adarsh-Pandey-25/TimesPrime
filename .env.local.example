# Copy this file to .env.local and fill in real values. .env.local is gitignored: never commit it.
# Every variable the code reads is listed here, one line each (F-009). Unset optional ones degrade
# as described; nothing else is read.

# --- Supabase (Dashboard -> Settings -> API) ---
# Project URL. Required for the stored feed, admin and audit log; without it the app runs on NewsData.io and mock articles.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key. Used only when the service-role key is unset, and then RLS refuses every write (docs/runbooks/apply-database.md).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only service-role key; bypasses RLS. Required for ingest, purge, admin writes and the audit log. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- News source ---
# NewsData.io API key (https://newsdata.io). Required: /api/health reports degraded without it.
NEWSDATA_API_KEY=your-newsdata-api-key

# --- AI ---
# Anthropic API key (https://console.anthropic.com) for /api/chat and category classification; without it chat says "unavailable" and classification is skipped.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Upstash Redis (https://upstash.com) ---
# Shared cache and the login/scrape rate limits across instances; without both, each instance uses its own memory.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Sentry (https://sentry.io) ---
# DSN for error reports from browser, server and edge; not a secret. Without it nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
# Build-time only, for source-map upload; safe to leave unset locally.
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug

# --- Secrets this app checks ---
# Bearer token for /api/cron/refresh-news (Vercel Cron sends it); unset, the endpoint answers 503.
CRON_SECRET=your-random-cron-secret
# The /admin login password; unset (or without ADMIN_SESSION_SECRET), login answers 503 and /admin stays locked.
ADMIN_PASSWORD=your-admin-password
# Signs the admin session cookie; changing it signs every admin out.
ADMIN_SESSION_SECRET=your-random-session-secret
# Generate either secret with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# The two above are the shared password, retired in code at 2027-01-01 00:00 IST. Set this to "off" to retire it sooner.
ADMIN_LEGACY_LOGIN=on

# --- URLs ---
# The site's public origin: the CORS allow-origin in production and the article page's og:url.
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
# Origin the article page fetches its suggested stories from (BL-016); defaults to http://localhost:3000.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Set by the platform; do not set them here ---
# NODE_ENV (Next.js), NEXT_RUNTIME (Next.js, nodejs or edge), CI (CI providers; makes the Sentry build plugin verbose).

# --- Local database only; never here ---
# LOCAL_DB_URL (Postgres of the local Supabase stack) is set only in .env.localdb, for npm run test:db
# and test:e2e. See .env.localdb.example and docs/runbooks/staff-access.md, Part A.

# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses Row Level Security — never expose to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NewsData.io API key (https://newsdata.io)
NEWSDATA_API_KEY=your-newsdata-api-key

# Anthropic API key (https://console.anthropic.com) — powers /api/chat.
# Without this, the chat widget and askTimesPrime box return a clear
# "AI assistant unavailable" message instead of crashing.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Upstash Redis (https://upstash.com, free tier) — shared cache for the news
# feed and article scraper across serverless instances. Without these, the
# app falls back to an in-memory cache automatically (fine for local dev;
# not shared across instances in production).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Sentry (https://sentry.io, free tier) — production error monitoring.
# Without SENTRY_DSN, the SDK is initialized but has nowhere to send events
# (effectively a no-op) — nothing crashes.
# DSN is not a secret (Sentry's own setup exposes it client-side), but must
# be NEXT_PUBLIC_-prefixed to reach the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
# Used only at build time to upload source maps — safe to leave unset locally.
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug

# Secret gating /api/cron/refresh-news, the 30-minute background job that
# refreshes Supabase from NewsData.io (schedule lives in vercel.json).
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`
# once the variable is set in the project's environment variables.
# Without it the endpoint fails closed (503) rather than letting anyone burn
# the NewsData.io quota.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=your-random-cron-secret

# Random secret used to gate /admin and /api/admin/*.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SECRET_TOKEN=your-random-admin-token

# Public site origin, used to restrict CORS in production and in OpenGraph metadata.
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Base URL the server uses for its own internal fetches (article scrape, suggested articles).
# Defaults to http://localhost:3000 in development if unset.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

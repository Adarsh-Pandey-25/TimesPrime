# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: every one is ignored (the owner's real .env at the root, any
# .env*.local, .env.production ...) except the two templates that hold no
# secret: .env.example, and .env.test, which empties every key for the tests.
.env*
!.env.example
!.env.test

# Playwright (npm run test:e2e)
/test-results/
/playwright-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Retired 2026-10-29 PRD snapshot; never consult it (docs/NEWSROOM_PLAN.md is the plan). The PDF
# predates the owner decisions of 2026-10-29 and must not be consulted.
docs/TimesPrime-PRD-and-Architecture.pdf

{
  "name": "timesprime",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "cd frontend && next dev",
    "build": "cd frontend && next build",
    "start": "cd frontend && next start",
    "lint": "eslint -c frontend/eslint.config.mjs",
    "typecheck": "tsc --noEmit -p frontend",
    "check:boundaries": "node backend/scripts/check-boundaries.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:boundaries && npm test && npm run build",
    "test": "cd frontend && jest",
    "test:watch": "cd frontend && jest --watch",
    "test:ci": "cd frontend && jest --ci --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@sentry/nextjs": "^10.78.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@upstash/redis": "^1.38.2",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

{
  "name": "timesprime",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @timesprime/web",
    "dev:admin": "npm run dev -w @timesprime/admin",
    "job": "npm run job -w @timesprime/worker --",
    "build": "npm run build -w @timesprime/web && npm run build -w @timesprime/admin",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/admin && tsc --noEmit -p apps/worker && tsc --noEmit -p packages/server && tsc --noEmit -p packages/shared && tsc --noEmit -p packages/ui && tsc --noEmit -p tsconfig.json",
    "check:js-budget": "node scripts/check-js-budget.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:js-budget",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@sentry/nextjs": "^10.78.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@upstash/redis": "^1.38.2",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
